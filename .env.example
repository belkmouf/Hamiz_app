# Odoo 18, read-only user (API key, not a password)
ODOO_URL=https://erp.hamizonline.com
ODOO_DB=
ODOO_USER=
ODOO_KEY=

# Meta Marketing API: system user token with ads_read only
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v24.0

# App
APP_ALLOWED_EMAILS=belkacem.mouffok@gmail.com
APP_SECRET_KEY=change-me-to-64-random-chars
APP_BASE_URL=https://pulse.example.com
PULSE_FORCE_HTTPS=1
DATABASE_URL=sqlite:///./pulse.db

# Email for sign-in links (without SMTP_HOST, links are printed to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


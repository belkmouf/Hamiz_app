# Odoo 18, read-only user (API key, not a password)
ODOO_URL=https://erp.hamizonline.com
ODOO_DB=
ODOO_USER=
ODOO_KEY=

# Meta Marketing API: system user token with ads_read only
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v24.0

# App
APP_ALLOWED_EMAILS=belkacem.mouffok@gmail.com
APP_SECRET_KEY=change-me-to-64-random-chars
APP_BASE_URL=https://pulse.example.com
PULSE_FORCE_HTTPS=1
DATABASE_URL=sqlite:///./pulse.db
# DZD the business pays per 1 USD of Meta spend (not the official rate)
PULSE_FX=250

# First admin. Created once, on API startup, when this email has no staff row yet.
# Password must be at least 8 characters. Leave blank to skip bootstrap.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Email for magic-link sign-in. Employees use passwords; magic links need SMTP.
# Without SMTP_HOST, a requested link is printed to the server log (local dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: extra Odoo field labels as JSON, merged over the defaults
# PULSE_ORDER_LABELS={"wilaya": ["wilaya livraison"], "utm_content": ["utm content"]}
# PULSE_LINE_LABELS={"seller": ["vendeur"]}
